{
  "name": "dark-reaction",
  "private": true,
  "version": "0.1.0",
  "description": "Dark Reaction《暗反應》: a bilingual late-night lab mystery",
  "license": "MIT",
  "author": "Angze Li",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "fonts": "node scripts/subset-fonts.ts",
    "predev": "npm run fonts",
    "dev": "vite",
    "build": "npm run fonts && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate": "npm run fonts && node scripts/validate.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@expo-google-fonts/ibm-plex-mono": "0.4.2",
    "@expo-google-fonts/noto-serif-tc": "0.4.2",
    "@expo-google-fonts/source-serif-4": "0.4.2",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
